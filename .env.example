# NEXORA AI environment configuration. Copy to .env and fill in. NEVER commit real secrets.
NEXORA_ENV=development
NEXORA_DATABASE_URL=sqlite:///./nexora.db            # production: postgresql+psycopg://user:pass@host:5432/nexora
NEXORA_REDIS_URL=redis://localhost:6379/0
NEXORA_JWT_SECRET=change-me-to-a-64-char-random-string
NEXORA_ACCESS_TOKEN_MINUTES=30
NEXORA_REFRESH_TOKEN_DAYS=14
# Super admin is seeded ONLY from these two variables. There is no public default password.
NEXORA_ADMIN_EMAIL=owner@yourdomain.com
NEXORA_ADMIN_PASSWORD=choose-a-long-random-password
NEXORA_FRONTEND_ORIGIN=http://localhost:3000
# Payment providers (server-side only)
NEXORA_RAZORPAY_KEY_ID=
NEXORA_RAZORPAY_KEY_SECRET=
NEXORA_RAZORPAY_WEBHOOK_SECRET=
NEXORA_PAYPAL_CLIENT_ID=
NEXORA_PAYPAL_CLIENT_SECRET=
NEXORA_PAYPAL_WEBHOOK_ID=
# AI provider: any OpenAI-compatible endpoint (self-hosted model or hosted API)
NEXORA_AI_API_KEY=
NEXORA_AI_API_BASE=https://api.openai.com/v1
NEXORA_AI_MODEL=gpt-4o-mini
# Email delivery provider (SMTP). Unconfigured = mail is skipped and logged, never claimed sent.
NEXORA_SMTP_HOST=
NEXORA_SMTP_PORT=587
NEXORA_SMTP_USER=
NEXORA_SMTP_PASSWORD=
NEXORA_SMTP_FROM=
# Voice provider (outbound calls). Leave empty to disable dialing; calls are then never dialed.
NEXORA_VOICE_PROVIDER=
NEXORA_VOICE_ACCOUNT_SID=
NEXORA_VOICE_AUTH_TOKEN=
NEXORA_VOICE_FROM_NUMBER=
